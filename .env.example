# Copy this file to .env and fill in your own keys. Never commit .env.

# ---------------------------------------------------------------------------
# Weather data (required) - free tier is enough
# https://home.openweathermap.org/api_keys
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Chat model (required). Any OpenAI-compatible provider works.
# Pick ONE of the setups below.
# ---------------------------------------------------------------------------

# --- Option 1: Groq - free, no credit card, fast ---------------------------
# Key from https://console.groq.com/keys
# Groq retires models periodically. If the app reports the model is
# unavailable, list current ones:
#   curl -H "Authorization: Bearer $OPENAI_API_KEY" https://api.groq.com/openai/v1/models
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# --- Option 2: Google Gemini - free tier, no credit card -------------------
# Key from https://aistudio.google.com/apikey
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash

# --- Option 3: Ollama - fully local, no key, no internet -------------------
# Install from https://ollama.com, then: ollama pull llama3.1
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# --- Option 4: OpenAI - requires paid credits ------------------------------
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
